# ===========================================================================
# VerdiCred Backend — Environment Configuration
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ===========================================================================

# ---- Server ----
PORT=3001
NODE_ENV=development
# Comma-separated list of allowed CORS origins (Next.js frontend)
API_CORS_ORIGIN=http://localhost:3000

# ---- Supabase ----
# Public / anon key (safe to expose to the browser; the backend uses it only
# to validate auth tokens via supabase.auth.getUser).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
# Service-role key — SERVER-ONLY, never expose to the browser.
# Used by admin scripts / tests that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# ---- Database (Prisma / PostgreSQL) ----
# Use the DIRECT Postgres connection (port 5432), NOT the Supabase pooler
# (6543) — pgbouncer transaction mode breaks Prisma's prepared statements.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
# Prisma migrate deploy uses this direct URL.
DIRECT_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ---- IPFS / Pinata (Stage2: Evidence) ----
# Create a JWT at https://app.pinata.cloud/developers/api-keys
PINATA_JWT=your-pinata-jwt
# Gateway used to build retrievable URLs (https://<gateway>/ipfs/<cid>).
PINATA_GATEWAY=your-gateway.mypinata.cloud

# ---- External evidence providers (Stage2) ----
# NASA EarthData: https://urs.earthdata.nasa.gov/  (used by NASAEarthDataAdapter)
NASA_API_KEY=your-nasa-api-key
# OpenWeather One Call 3.0: https://home.openweathermap.org/api_keys
# When set, OpenWeatherAdapter performs a LIVE fetch; otherwise it emits a
# reproducible request descriptor so the ingestion flow still works end-to-end.
OPENWEATHER_API_KEY=your-openweather-api-key

# ---- Stage 4: Carbon Credit Issuance (Solana / Anchor / SPL Token-2022) ----
# Deployed program ID (from stage4-carbon-credits/target/deploy/.program_id after `anchor deploy`).
SOLANA_PROGRAM_ID=41jbriQNyaJLuUfJWennbwVqGTQeBDc94Ywj4pGBarnv
# RPC endpoint (defaults to Solana devnet when unset). Use a dedicated RPC for production.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Verifier Oracle Authority secret key — SERVER-ONLY, never expose to the browser.
# Accepts base58, JSON array, or comma-separated numbers. The backend signs mint
# transactions with this key; leave unset to run in degraded (no-chain) mode.
VERIFIER_ORACLE_SECRET_KEY=

# ---- Stage 5: Marketplace settlement (BlockchainService) ----
# The marketplace runs on a MOCK settlement layer by default so it works
# end-to-end without the Stage 4 program being deployed. Set to `true` (and
# ensure SOLANA_PROGRAM_ID above is set) to enable real on-chain SPL Token-2022
# transfer + settlement once the program is deployed.
MARKETPLACE_ONCHAIN=false
# Explorer cluster used to build settlement tx links (devnet | mainnet-beta | testnet).
SOLANA_CLUSTER=devnet

# ---- Stage 6: Credit Retirement ----
# The retirement runs on a MOCK blockchain seam by default (mirrors the Stage 5
# marketplace) so the full lifecycle works end-to-end without the retirement
# program being deployed. Set to `true` (and ensure SOLANA_PROGRAM_ID above is
# set) to enable real on-chain retirement once the program is deployed.
RETIREMENT_ONCHAIN=false
# Base URL used to build the certificate QR / verification link. Defaults to the
# frontend origin (APP_FRONTEND_URL) when unset.
CERTIFICATE_VERIFY_BASE=http://localhost:3000
# Frontend origin used to build certificate verification URLs.
APP_FRONTEND_URL=http://localhost:3000
